Group    gCam            "Kamera WC0030A"          <camera>

Contact  Cam_Motion      "Bewegung [MAP(wc0030a_motion.map):%s]" <motion> (gCam) { channel="mqtt:topic:camBroker:wc0030a:motion" }
Contact  Cam_Alarm       "Alarm [%s]"              <siren>        (gCam) { channel="mqtt:topic:camBroker:wc0030a:alarm" }
Contact  Cam_Input1      "Alarmeingang 1 [%s]"     <contact>      (gCam) { channel="mqtt:topic:camBroker:wc0030a:input1" }
String   Cam_Resolution  "Auflösung [%s]"          <screen>       (gCam) { channel="mqtt:topic:camBroker:wc0030a:resolution" }
Number   Cam_Framerate   "Bildrate [%d fps]"       <line>         (gCam) { channel="mqtt:topic:camBroker:wc0030a:framerate" }
Number   Cam_SdFree      "SD frei [%d MB]"         <returnpipe>   (gCam) { channel="mqtt:topic:camBroker:wc0030a:sdFree" }
Number   Cam_SdTotal     "SD gesamt [%d MB]"       <returnpipe>   (gCam) { channel="mqtt:topic:camBroker:wc0030a:sdTotal" }
String   Cam_Firmware    "Firmware [%s]"           <text>         (gCam) { channel="mqtt:topic:camBroker:wc0030a:firmware" }
String   Cam_LastError   "Letzter Fehler [%s]"     <error>        (gCam) { channel="mqtt:topic:camBroker:wc0030a:lastError" }

Image    Cam_Snapshot    "Schnappschuss"           <camera>       (gCam) { channel="mqtt:topic:camBroker:wc0030a:snapshot" }
DateTime Cam_SnapshotTime "Aufgenommen [%1$tH:%1$tM:%1$tS]" <time> (gCam) { channel="mqtt:topic:camBroker:wc0030a:snapshotTime" }
String   Cam_SnapshotCmd "Bild anfordern"          <camera>       (gCam) { channel="mqtt:topic:camBroker:wc0030a:snapshotCmd", autoupdate="false" }

String   Cam_PTZ         "Schwenken"               <movecontrol>  (gCam) { channel="mqtt:topic:camBroker:wc0030a:ptz", autoupdate="false" }
String   Cam_PTZMove     "Dauerfahrt"              <movecontrol>  (gCam) { channel="mqtt:topic:camBroker:wc0030a:ptzMove", autoupdate="false" }
Number   Cam_Preset      "Position"                <zoom>         (gCam) { channel="mqtt:topic:camBroker:wc0030a:preset", autoupdate="false" }
Number   Cam_PresetSet   "Position speichern"      <zoom>         (gCam) { channel="mqtt:topic:camBroker:wc0030a:presetSet", autoupdate="false" }
String   Cam_Patrol      "Patrouille [%s]"         <flow>         (gCam) { channel="mqtt:topic:camBroker:wc0030a:patrol" }
Switch   Cam_Relay       "Relais"                  <poweroutlet>  (gCam) { channel="mqtt:topic:camBroker:wc0030a:relay" }
