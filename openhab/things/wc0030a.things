// MQTT-Anbindung der WC0030A über die Bridge (python -m wc0030a mqtt).
// Broker-Daten anpassen; existiert bereits ein Broker-Bridge-Thing,
// nur das innere "Thing topic ..." übernehmen und die UIDs in den Items anpassen.
Bridge mqtt:broker:camBroker "Mosquitto (Kamera-Pi)" [ host="192.168.0.10", port=1883, secure=false, username="", password="" ] {

    Thing topic wc0030a "LogiLink WC0030A" @ "Smart Home Lab" [
        availabilityTopic="wc0030a/status", payloadAvailable="online", payloadNotAvailable="offline"
    ] {
    Channels:
        // Zustände
        Type contact  : motion        "Bewegung"          [ stateTopic="wc0030a/state/motion", on="ON", off="OFF" ]
        Type contact  : alarm         "Alarm"             [ stateTopic="wc0030a/state/alarm",  on="ON", off="OFF" ]
        Type contact  : input1        "Alarmeingang 1"    [ stateTopic="wc0030a/state/input1", on="ON", off="OFF" ]
        Type string   : resolution    "Auflösung"         [ stateTopic="wc0030a/state/resolution" ]
        Type number   : framerate     "Bildrate"          [ stateTopic="wc0030a/state/framerate" ]
        Type number   : sdFree        "SD frei"           [ stateTopic="wc0030a/state/sd_free_mb" ]
        Type number   : sdTotal       "SD gesamt"         [ stateTopic="wc0030a/state/sd_total_mb" ]
        Type string   : firmware      "Firmware"          [ stateTopic="wc0030a/state/firmware" ]
        Type string   : lastError     "Letzter Fehler"    [ stateTopic="wc0030a/state/last_error" ]

        // Bild
        Type image    : snapshot      "Schnappschuss"     [ stateTopic="wc0030a/snapshot" ]
        Type datetime : snapshotTime  "Aufgenommen"       [ stateTopic="wc0030a/state/snapshot_time" ]
        Type string   : snapshotCmd   "Bild anfordern"    [ commandTopic="wc0030a/cmd/snapshot" ]

        // Steuerung
        Type string   : ptz           "PTZ-Schritt"       [ commandTopic="wc0030a/cmd/ptz" ]
        Type string   : ptzMove       "PTZ-Fahrt"         [ commandTopic="wc0030a/cmd/ptz/move" ]
        Type number   : preset        "Position anfahren" [ commandTopic="wc0030a/cmd/preset" ]
        Type number   : presetSet     "Position speichern"[ commandTopic="wc0030a/cmd/preset/set" ]
        Type string   : patrol        "Patrouille"        [ stateTopic="wc0030a/state/patrol", commandTopic="wc0030a/cmd/patrol" ]
        Type switch   : relay         "Relais"            [ stateTopic="wc0030a/state/relay",  commandTopic="wc0030a/cmd/relay" ]
        Type number   : cruise        "Kurs"              [ commandTopic="wc0030a/cmd/cruise" ]

        // Bewegungserkennung der Kamera
        Type switch   : detection     "Bewegungserkennung"[ stateTopic="wc0030a/state/motion/enable", commandTopic="wc0030a/cmd/motion/enable" ]
        Type number   : sensitivity   "Empfindlichkeit"   [ stateTopic="wc0030a/state/motion/level",  commandTopic="wc0030a/cmd/motion/level", min=1, max=5 ]

        // Bild
        Type number   : brightness    "Helligkeit"        [ stateTopic="wc0030a/state/camera/brightness", commandTopic="wc0030a/cmd/camera/brightness", min=0, max=255 ]
        Type number   : contrast      "Kontrast"          [ stateTopic="wc0030a/state/camera/contrast",   commandTopic="wc0030a/cmd/camera/contrast",   min=0, max=255 ]
        Type number   : saturation    "Sättigung"         [ stateTopic="wc0030a/state/camera/saturation", commandTopic="wc0030a/cmd/camera/saturation", min=0, max=200 ]
        Type number   : hue           "Farbton"           [ stateTopic="wc0030a/state/camera/hue",        commandTopic="wc0030a/cmd/camera/hue",        min=-128, max=127 ]
        Type number   : ptzSpeed      "PTZ-Tempo"         [ stateTopic="wc0030a/state/camera/ptzspeed",   commandTopic="wc0030a/cmd/camera/ptzspeed",   min=1, max=100 ]
        Type switch   : mirror        "Spiegeln"          [ stateTopic="wc0030a/state/camera/mirror",     commandTopic="wc0030a/cmd/camera/mirror", on="1", off="0" ]
        Type switch   : flip          "Drehen"            [ stateTopic="wc0030a/state/camera/flip",       commandTopic="wc0030a/cmd/camera/flip",   on="1", off="0" ]
        Type number   : osdColor      "OSD-Farbe"         [ stateTopic="wc0030a/state/camera/OSDTimer",   commandTopic="wc0030a/cmd/camera/OSDTimer" ]
        Type number   : mainsHz       "Netzfrequenz"      [ stateTopic="wc0030a/state/camera/aec_value",  commandTopic="wc0030a/cmd/camera/aec_value" ]
        Type number   : lamp          "Status-LED"        [ stateTopic="wc0030a/state/lamp",              commandTopic="wc0030a/cmd/lamp" ]
    }
}

// Optional: Video direkt über das IpCamera-Binding (Snapshot + MJPEG, kein MQTT nötig).
// Zugangsdaten stehen hier im Klartext in der URL – Alternative: Video-Element der
// Sitemap auf die Flask-Oberfläche des Pi zeigen lassen (siehe Sitemap).
// Thing ipcamera:httponly:wc0030a "WC0030A Video" @ "Smart Home Lab" [
//     ipAddress="192.168.0.35",
//     snapshotUrl="http://192.168.0.35/cgi-bin/video_snapshot.cgi?user=admin&pwd=GEHEIM",
//     ffmpegInput="rtsp://192.168.0.35:554/live/av0?user=admin&passwd=GEHEIM",
//     mjpegUrl="http://192.168.0.35/cgi-bin/videostream.cgi?user=admin&pwd=GEHEIM"
// ]
