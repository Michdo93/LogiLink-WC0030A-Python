[Unit]
Description=LogiLink WC0030A Weboberfläche
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/LogiLink-WC0030A-Python
ExecStart=/opt/LogiLink-WC0030A-Python/.venv/bin/python -m wc0030a -c /opt/LogiLink-WC0030A-Python/config.yaml web
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
